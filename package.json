{
  "name": "@shelf/fast-uslug",
  "version": "1.2.0",
  "description": "A 30x faster version of the \"uslug\" package",
  "license": "MIT",
  "packageManager": "pnpm@11.18.0",
  "author": {
    "name": "Vlad Holubiev",
    "email": "vlad@shelf.io",
    "url": "https://shelf.io"
  },
  "sideEffects": false,
  "type": "module",
  "exports": "./lib/index.js",
  "module": "./lib/index.js",
  "types": "lib/index.d.ts",
  "files": [
    "lib"
  ],
  "scripts": {
    "benchmark": "tsx benchmark.ts",
    "build": "rm -rf lib/ && tsc",
    "coverage": "pnpm test --coverage",
    "lint": "oxfmt && eslint . --quiet --fix",
    "lint:ci": "oxfmt --check && eslint . --quiet",
    "prepack": "pnpm build",
    "test": "TZ=UTC jest src",
    "type-check": "tsc --noEmit",
    "type-check:watch": "npm run type-check -- --watch"
  },
  "lint-staged": {
    "*.{html,md,yml}": [
      "oxfmt --no-error-on-unmatched-pattern"
    ],
    "*.{js,ts,json}": [
      "oxfmt --no-error-on-unmatched-pattern",
      "eslint --fix"
    ]
  },
  "devDependencies": {
    "@shelf/eslint-config": "7.1.0",
    "@shelf/prettier-config": "1.1.1",
    "@shelf/tsconfig": "0.2.0",
    "@swc/core": "1.13.5",
    "@swc/jest": "0.2.39",
    "@types/jest": "30.0.0",
    "@types/node": "20.17.10",
    "@types/uslug": "1.0.4",
    "benny": "3.7.1",
    "eslint": "10.8.0",
    "fast-lorem-ipsum": "1.2.0",
    "husky": "9.1.7",
    "jest": "30.3.0",
    "jest-junit": "16.0.0",
    "lint-staged": "15.5.2",
    "oxfmt": "0.64.0",
    "ts-jest-resolver": "2.0.1",
    "tsx": "4.20.5",
    "typescript": "6.0.3",
    "uslug": "1.0.4"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  }
}
